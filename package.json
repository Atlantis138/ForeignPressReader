{
  "name": "foreign-press-reader",
  "version": "1.0.0",
  "packageManager": "pnpm@11.0.0",
  "engines": {
    "node": ">=24"
  },
  "private": true,
  "description": "Local-first Windows and Android EPUB reader and English learning app",
  "author": "Atlantis138",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Atlantis138/ForeignPressReader.git"
  },
  "homepage": "https://github.com/Atlantis138/ForeignPressReader#readme",
  "bugs": {
    "url": "https://github.com/Atlantis138/ForeignPressReader/issues"
  },
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "concurrently -k \"pnpm dev:renderer\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "dev:renderer": "vite",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "typecheck": "tsc -p tsconfig.core.json && tsc -p tsconfig.json && tsc -p tsconfig.electron.json --noEmit",
    "build": "pnpm typecheck && pnpm build:renderer && pnpm build:electron",
    "lint": "eslint . && depcruise --config dependency-cruiser.config.cjs src/core src/main src/preload src/renderer src/shared",
    "audit:prod": "pnpm audit --prod --audit-level moderate",
    "test": "pnpm build:renderer && pnpm build:electron && vitest run",
    "test:interop": "pnpm build:electron && cross-env FPR_RUN_RUST_INTEROP=1 vitest run tests/portable-interop.test.ts",
    "test:protocol": "pnpm build && node scripts/protocol-smoke.mjs --source",
    "test:protocol:packaged": "node scripts/protocol-smoke.mjs --packaged",
    "test:watch": "vitest",
    "perf:smoke": "pnpm build && electron-builder --dir --win --x64 && pnpm test:protocol:packaged && node scripts/perf-smoke.mjs",
    "dist": "pnpm build && electron-builder --win nsis --x64",
    "icons:generate": "node scripts/generate-app-icon-variants.mjs && tauri icon src-tauri/icons/app-icon-manifest.json --output src-tauri/icons",
    "tauri": "tauri",
    "tauri:android:init": "tauri android init",
    "tauri:android:dev": "tauri android dev --host 127.0.0.1",
    "tauri:android:build": "tauri android build --config src-tauri/tauri.release.conf.json --target aarch64 --split-per-abi --apk --ci"
  },
  "dependencies": {
    "@noble/hashes": "2.2.0",
    "@peculiar/x509": "^2.0.0",
    "@tauri-apps/api": "2.11.1",
    "archiver": "7.0.1",
    "bonjour-service": "^1.4.3",
    "cheerio": "1.1.2",
    "csv-parse": "6.1.0",
    "fast-xml-parser": "5.9.3",
    "jszip": "3.10.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "reflect-metadata": "^0.2.2",
    "sanitize-html": "2.17.0",
    "ts-fsrs": "5.4.1",
    "yauzl": "3.2.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/react": "^16.3.2",
    "@types/archiver": "6.0.3",
    "@types/node": "24.10.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/sanitize-html": "2.16.0",
    "@types/yauzl": "2.10.3",
    "@vitejs/plugin-react": "6.0.3",
    "concurrently": "9.2.1",
    "cross-env": "10.1.0",
    "dependency-cruiser": "18.1.0",
    "electron": "43.0.0",
    "electron-builder": "26.15.3",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "^29.1.1",
    "playwright": "1.61.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vite": "8.1.3",
    "vitest": "4.1.9",
    "wait-on": "9.0.4"
  },
  "build": {
    "appId": "com.local.foreignpressreader",
    "productName": "外刊阅读器",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "!**/*.map",
      "!**/{test,tests,__tests__}/**/*",
      "!**/*.{spec,test}.{js,cjs,mjs,ts,tsx}"
    ],
    "win": {
      "icon": "src-tauri/icons/icon.ico",
      "electronLanguages": [
        "zh-CN",
        "en-US"
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ForeignPressReader-${version}-Setup.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
